{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/unification-com/mainchain-upgrade-simulator/schema/config.schema.json",
  "title": "Upgrade simulator config.json",
  "description": "Validated at the start of `make gen`. Every object rejects unknown keys, so a misspelt field fails fast instead of being silently ignored by the generator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apps", "docker"],
  "properties": {
    "apps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["und", "ibc", "cosmovisor"],
      "properties": {
        "und": {
          "type": "object",
          "additionalProperties": false,
          "required": ["chain_id", "genesis_time", "genesis", "upgrade", "nodes", "staking", "accounts"],
          "properties": {
            "chain_id": { "$ref": "#/definitions/chainId" },
            "genesis_time": { "type": "string", "format": "date-time" },
            "genesis": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version"],
              "properties": {
                "version": { "$ref": "#/definitions/semver", "description": "und release used at genesis - the version upgraded FROM" }
              }
            },
            "upgrade": {
              "type": "object",
              "additionalProperties": false,
              "required": ["branch", "upgrade_height", "upgrade_plan_name"],
              "properties": {
                "branch": { "$ref": "#/definitions/nonEmptyToken", "description": "mainchain git branch or tag built as the upgrade binary" },
                "upgrade_height": { "type": "integer", "minimum": 1 },
                "upgrade_plan_name": { "$ref": "#/definitions/nonEmptyToken", "description": "must match the plan registered in the upgrade binary" }
              }
            },
            "nodes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["num_validators", "num_sentries", "num_seeds", "num_rpcs"],
              "properties": {
                "num_validators": { "type": "integer", "minimum": 1 },
                "num_sentries": { "type": "integer", "minimum": 0 },
                "num_seeds": { "type": "integer", "minimum": 0 },
                "num_rpcs": { "type": "integer", "minimum": 1, "description": "rpc1 is required: Hermes, the tx runner and the proxy all connect to it" }
              }
            },
            "staking": {
              "type": "object",
              "additionalProperties": false,
              "required": ["min_stake", "max_stake", "small_min_stake", "small_max_stake"],
              "properties": {
                "min_stake": { "$ref": "#/definitions/nund" },
                "max_stake": { "allOf": [{ "$ref": "#/definitions/nund" }, { "type": "integer", "minimum": { "$data": "1/min_stake" } }] },
                "small_min_stake": { "$ref": "#/definitions/nund" },
                "small_max_stake": { "allOf": [{ "$ref": "#/definitions/nund" }, { "type": "integer", "minimum": { "$data": "1/small_min_stake" } }] },
                "stake_overrides": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["validator"],
                    "properties": {
                      "validator": { "type": "integer", "minimum": 1, "description": "1-based validator number; an override beyond num_validators is ignored by the generator (reported as a warning)" },
                      "rate": { "$ref": "#/definitions/fraction" },
                      "max_rate": { "$ref": "#/definitions/fraction" },
                      "max_change_rate": { "$ref": "#/definitions/fraction" },
                      "stake": { "$ref": "#/definitions/nund" },
                      "min_self": { "type": "integer", "minimum": 1 }
                    }
                  }
                }
              }
            },
            "accounts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["nund", "ent_po_amount", "num_ent_signers", "num_ent_accepts", "num_wrhchains", "num_beacons", "num_tests", "storage_purchase", "payment_streams"],
              "properties": {
                "nund": { "$ref": "#/definitions/nund" },
                "ent_po_amount": { "$ref": "#/definitions/nund" },
                "num_ent_signers": { "type": "integer", "minimum": 1 },
                "num_ent_accepts": { "type": "integer", "minimum": 1, "maximum": { "$data": "1/num_ent_signers" }, "description": "enterprise PO acceptance threshold - cannot exceed the number of signers" },
                "num_wrhchains": { "type": "integer", "minimum": 0, "description": "number of WRKChains (the key's spelling is what the generator reads)" },
                "num_beacons": { "type": "integer", "minimum": 0 },
                "num_tests": { "type": "integer", "minimum": 0 },
                "storage_purchase": { "type": "integer", "minimum": 0 },
                "payment_streams": { "type": "integer", "minimum": 0 },
                "static": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["address", "nund"],
                    "properties": {
                      "address": { "type": "string", "pattern": "^und1[02-9ac-hj-np-z]{38}$" },
                      "nund": { "$ref": "#/definitions/integerString" }
                    }
                  }
                }
              }
            }
          }
        },
        "ibc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "hermes_version", "chain_id", "accounts"],
          "properties": {
            "version": { "$ref": "#/definitions/semver", "description": "gaiad release for the IBC counterparty chain" },
            "hermes_version": { "$ref": "#/definitions/semver" },
            "chain_id": { "$ref": "#/definitions/chainId" },
            "accounts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["num_ibc_accounts"],
              "properties": {
                "num_ibc_accounts": { "type": "integer", "minimum": 0 },
                "static": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["address", "stake"],
                    "properties": {
                      "address": { "type": "string", "pattern": "^cosmos1[02-9ac-hj-np-z]{38}$" },
                      "stake": { "$ref": "#/definitions/integerString" }
                    }
                  }
                }
              }
            }
          }
        },
        "cosmovisor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": {
            "version": { "$ref": "#/definitions/semver" }
          }
        }
      }
    },
    "docker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["container_prefix", "network"],
      "properties": {
        "container_prefix": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subnet", "ip_start", "p2p_port_start", "rpc_port_start", "rest_port_start", "grpc_port_start"],
          "properties": {
            "subnet": { "type": "string", "pattern": "^(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])){2}$", "description": "first three octets, e.g. 172.25.1" },
            "ip_start": { "type": "integer", "minimum": 2, "maximum": 254 },
            "p2p_port_start": { "$ref": "#/definitions/port" },
            "rpc_port_start": { "$ref": "#/definitions/port" },
            "rest_port_start": { "$ref": "#/definitions/port" },
            "grpc_port_start": { "$ref": "#/definitions/port" }
          }
        }
      }
    }
  },
  "definitions": {
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "description": "release number without a leading v, e.g. 1.12.0" },
    "chainId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "nonEmptyToken": { "type": "string", "pattern": "^\\S+$" },
    "nund": { "type": "integer", "minimum": 0 },
    "integerString": { "type": "string", "pattern": "^[0-9]+$" },
    "fraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
  }
}
